generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  BUYER
  SELLER
  DELIVERER
  SUPPORT
  ADMIN
}

enum Platform {
  WEB
  MOBILE
}

enum OtpType {
  EMAIL_VERIFICATION
  PHONE_VERIFICATION
  ACCOUNT_VERIFICATION
  SIGNIN
  RESET_PASSWORD
  CHANGE_EMAIL
  CHANGE_PHONE
  TWO_FACTOR
  REMOVE_PASSKEY
  DISCONNECT_GOOGLE
  DISABLE_2FA
  REGENERATE_BACKUP_CODES
}

enum ComponentStatus {
  OPERATIONAL
  DEGRADED
  PARTIAL_OUTAGE
  MAJOR_OUTAGE
}

enum IncidentStatus {
  INVESTIGATING
  IDENTIFIED
  MONITORING
  RESOLVED
}

enum IncidentSeverity {
  MINOR
  MAJOR
  CRITICAL
}

enum Language {
  FR
  SW
}

enum KycStatus {
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
}

enum KycCountry {
  COD
  RWA
}

enum Country {
  COD // DR Congo
  RWA // Rwanda
}

enum SellerType {
  INDIVIDUAL
  BUSINESS
}

enum IdDocumentType {
  NATIONAL_ID
  VOTERS_CARD
  PASSPORT
  RESIDENCE_PERMIT
}

enum OnboardingStatus {
  PENDING_KYC
  KYC_REJECTED
  PENDING_SUBSCRIPTION
  PENDING_PAYOUT
  PENDING_SHOP_SETUP
  ACTIVE
  SUSPENDED
}

enum SupportLevel {
  EMAIL
  PRIORITY
  DEDICATED
}

enum AnalyticsLevel {
  BASIC
  ADVANCED
  ENTERPRISE
}

enum SubscriptionStatus {
  PENDING_PAYMENT
  ACTIVE
  EXPIRED
  CANCELLED
  PAST_DUE
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum PawaPayTransactionType {
  DEPOSIT
  PAYOUT
  REFUND
}

enum PawaPayTransactionPurpose {
  SUBSCRIPTION
  ORDER_PAYMENT
  WALLET_TOPUP
  WALLET_PAYOUT
}

enum PawaPayTransactionStatus {
  PENDING
  ACCEPTED
  COMPLETED
  FAILED
  REJECTED
  DUPLICATE_IGNORED
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id                String    @id @default(uuid())
  name              String
  phone             String?   @unique
  email             String?   @unique
  password          String?
  passwordChangedAt DateTime?
  role              Role      @default(BUYER)
  avatar            String?
  googleId          String?   @unique

  secondaryEmail           String?   @unique
  isSecondaryEmailVerified Boolean   @default(false)
  secondaryEmailAddedAt    DateTime?

  isVerified      Boolean @default(false)
  isDeleted       Boolean @default(false)
  isEmailVerified Boolean @default(false)
  isPhoneVerified Boolean @default(false)
  isActive        Boolean @default(true)
  isBlocked       Boolean @default(false)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  otps          Otp[]
  refreshTokens RefreshToken[]
  sessions      Session[]
  passkeys      Passkey[]
  totp          Totp?
  backupCodes   BackupCode[]
  addresses     Address[]
  sellerProfile SellerProfile?
  kycReviews    Kyc[]          @relation("KycReviewer")

  @@map("users")
}

model Otp {
  id        String    @id @default(uuid())
  userId    String
  code      String
  type      String
  target    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("otps")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  sessionId String?
  token     String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  platform        Platform @default(WEB)
  deviceId        String?
  replacedByToken String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@index([deviceId])
  @@map("refresh_tokens")
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  device       String?
  browser      String?
  os           String?
  ip           String?
  location     String?
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Passkey {
  id           String    @id @default(uuid())
  userId       String
  name         String
  credentialId String    @unique
  publicKey    Bytes
  counter      BigInt    @default(0)
  deviceType   String?
  backedUp     Boolean   @default(false)
  transports   String[]
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passkeys")
}

model Totp {
  id        String    @id @default(uuid())
  userId    String    @unique
  secret    String
  isEnabled Boolean   @default(false)
  enabledAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("totp")
}

model BackupCode {
  id        String    @id @default(uuid())
  userId    String
  code      String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("backup_codes")
}

model Address {
  id        String   @id @default(uuid())
  userId    String
  label     String
  commune   String
  quartier  String
  avenue    String
  reference String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

// ─── PROFILES ───────────────────────────────────────────────────────────────────

model SellerProfile {
  id     String @id @default(uuid())
  userId String @unique

  country          Country
  isApproved       Boolean          @default(false)
  onboardingStatus OnboardingStatus @default(PENDING_KYC)
  approvedAt       DateTime?
  approvedBy       String?

  pawapaySubMerchantAgreementAcceptedAt DateTime?

  payoutPhoneNumber String?
  payoutProvider    String?
  payoutCurrency    String?

  businessPhone String?
  businessEmail String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  kyc                 Kyc?
  subscription        Subscription?
  shops               Shop[]
  pawapayTransactions PawaPayTransaction[]

  @@index([onboardingStatus])
  @@index([isApproved])
  @@map("seller_profiles")
}

model Shop {
  id              String @id @default(uuid())
  sellerProfileId String

  name        String
  slug        String  @unique
  description String?
  logo        String
  coverImage  String?

  country   Country
  commune   String
  quartier  String
  avenue    String
  reference String?
  latitude  Float?
  longitude Float?

  isActive  Boolean @default(true)
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sellerProfile SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)

  @@index([sellerProfileId])
  @@map("shops")
}

model Kyc {
  id              String @id @default(uuid())
  sellerProfileId String @unique

  sellerType SellerType @default(INDIVIDUAL)

  idType     IdDocumentType?
  idNumber   String?
  idFrontUrl String?
  idBackUrl  String?
  selfieUrl  String?

  businessName               String?
  businessRegistrationNumber String?
  businessDocUrl             String?

  status      KycStatus @default(PENDING)
  note        String?
  reviewedBy  String?
  reviewedAt  DateTime?
  submittedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sellerProfile SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)
  reviewer      User?         @relation("KycReviewer", fields: [reviewedBy], references: [id])

  @@index([status])
  @@map("kyc")
}

model Plan {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?

  maxShops                    Int
  maxImagesPerProduct         Int
  maxDelivererPartners        Int?
  maxProducts                 Int?
  maxFeaturedListingsPerMonth Int?

  supportLevel   SupportLevel
  analyticsLevel AnalyticsLevel

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  prices PlanPrice[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]

  @@map("plans")
}

model PlanPrice {
  id      String  @id @default(uuid())
  planId  String
  country Country

  currency     String
  priceMonthly Decimal @db.Decimal(12, 2)
  isDefault    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, country, currency])
  @@map("plan_prices")
}

model Subscription {
  id              String @id @default(uuid())
  sellerProfileId String @unique
  planId          String

  country      Country
  currency     String
  amount       Decimal      @db.Decimal(12, 2)
  billingCycle BillingCycle @default(MONTHLY)

  status    SubscriptionStatus @default(PENDING_PAYMENT)
  autoRenew Boolean            @default(true)

  startedAt   DateTime?
  expiresAt   DateTime?
  cancelledAt DateTime?

  pawapayDepositId   String? @unique
  paymentPhoneNumber String?
  paymentProvider    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sellerProfile       SellerProfile        @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)
  plan                Plan                 @relation(fields: [planId], references: [id])
  pawapayTransactions PawaPayTransaction[]

  @@index([status])
  @@index([pawapayDepositId])
  @@map("subscriptions")
}

model PawaPayTransaction {
  id String @id @default(uuid())

  type    PawaPayTransactionType
  purpose PawaPayTransactionPurpose
  status  PawaPayTransactionStatus  @default(PENDING)

  amount        Decimal @db.Decimal(12, 2)
  currency      String
  correspondent String
  country       String
  phoneNumber   String

  clientReferenceId String?

  subscriptionId  String?
  orderId         String?
  sellerProfileId String?

  providerTransactionId String?
  failureReason         Json?
  rawCallbackPayload    Json?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  subscription  Subscription?  @relation(fields: [subscriptionId], references: [id])
  sellerProfile SellerProfile? @relation(fields: [sellerProfileId], references: [id])

  @@index([status])
  @@index([purpose])
  @@index([subscriptionId])
  @@index([orderId])
  @@index([sellerProfileId])
  @@index([clientReferenceId])
  @@map("pawapay_transactions")
}
