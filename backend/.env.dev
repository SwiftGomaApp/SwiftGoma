# ── PawaPay ────────────────────────────────────────────────────────────────
# "sandbox" or "production"
PAWAPAY_ENV=sandbox

# Generate this from the pawaPay Dashboard -> System Configuration -> API Token
# Use a DIFFERENT token for sandbox vs production.
PAWAPAY_SANDBOX_API_TOKEN=your_sandbox_token_here
PAWAPAY_PRODUCTION_API_TOKEN=your_production_token_here

# Where pawaPay will POST final statuses (deposit/payout/refund callbacks).
# Configure the SAME urls in the pawaPay Dashboard (Callback URLs section).
PAWAPAY_CALLBACK_BASE_URL=https://your-domain.com/api/pawapay/callbacks

# Optional: if you enabled "Only accept signed requests" / "Signed callbacks"
# in the Dashboard, put your key info here (used later for RFC-9421 signing/verifying)
PAWAPAY_SIGNED_REQUESTS=false
PAWAPAY_SIGNED_CALLBACKS=false

# ── Your pawaPay wallet info (per-country wallets) ──────────────────────────
# pawaPay gives you one wallet per country/currency you're onboarded for.
# You don't "configure" these — they're fetched live from pawaPay
# (see walletBalances() in the service) — but you can optionally cache
# the countries you operate in here for quick reference/UI dropdowns.
PAWAPAY_ACTIVE_COUNTRIES=RWA,COD,ZMB
