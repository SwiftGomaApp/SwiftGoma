const cron = require("node-cron");
const statusService = require("../services/status.service");

const startHealthCheckCron = () => {
  cron.schedule("* * * * *", async () => {
    try {
      await statusService.runHealthChecks();
    } catch (err) {
      console.error("Health check cron error:", err.message);
    }
  });

  cron.schedule("0 3 * * *", async () => {
    try {
      await statusService.cleanupOldChecks(90);
    } catch (err) {
      console.error("Health check cleanup error:", err.message);
    }
  });

  console.log("✅ Status page health-check cron started");
};

module.exports = { startHealthCheckCron };
