generator client {
  provider               = "prisma-client-js"
  output                 = "../generated/prisma"
  moduleFormat           = "cjs"
  generatedFileExtension = "js"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

// ====================================== ENUMS ===============================

enum Role {
  BUYER
  SELLER
  RIDER
  ADMIN
  SUPPORT
}

enum SellerProfileStatus {
  DRAFT
  ACTIVE
  SUSPENDED
}

enum KycStatus {
  PENDING
  SUPPORT_REVIEWED
  APPROVED
  REJECTED
}

enum IdDocumentType {
  NATIONAL_ID
  VOTER_CARD
  PASSPORT
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  PENDING_PAYMENT
  ACTIVE
  FAILED_PAYMENT
  PAST_DUE
  EXPIRED
  CANCELED
}

enum SubscriptionPaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum InvoiceDocumentType {
  INVOICE
  RECEIPT
  PAYOUT_RECEIPT
}

enum ShopStatus {
  DRAFT
  PUBLISHED
  SUSPENDED
}

enum ShopSuspendedBy {
  SELLER
  ADMIN
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum StockMovementType {
  RESTOCK
  SALE
  ADJUSTMENT
  RETURN
}

enum RiderStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum VehicleType {
  MOTORCYCLE
  BICYCLE
  CAR
  ON_FOOT
}

enum OrderStatus {
  AWAITING_PAYMENT
  PENDING_SELLER_REVIEW
  ACCEPTED
  PREPARING
  READY_FOR_PICKUP
  RIDER_ASSIGNED
  PICKED_UP
  ON_THE_WAY
  DELIVERED
  COMPLETED
  REJECTED
  CANCELLED
  EXPIRED
  FAILED
}

enum OrderPaymentMethod {
  CASH_ON_DELIVERY
  ONLINE_PAYMENT
}

enum OrderFulfillmentMethod {
  DELIVERY
  PICKUP
}

enum OrderPaymentStatus {
  PENDING
  SUCCEEDED
  RELEASED
  REFUNDED
  FAILED
}

enum WalletTransactionType {
  ORDER_CREDIT
  PAYOUT_DEBIT
  REFUND_DEBIT
  ADJUSTMENT
}

enum WalletTransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

// ====================================== MODELS ===============================

model User {
  id           String  @id @default(uuid())
  name         String
  phone        String?
  pendingPhone String?
  password     String?
  role         Role    @default(BUYER)
  avatarUrl    String?

  isPhoneVerified Boolean @default(false)
  isBlocked       Boolean @default(false)

  deletedAt      DateTime?
  deletionReason String?

  phoneVerificationCode          String?
  phoneVerificationCodeExpiresAt DateTime?

  loginOtp          String?
  loginOtpExpiresAt DateTime?

  passwordResetCode          String?
  passwordResetCodeExpiresAt DateTime?

  accountRecoveryCode          String?
  accountRecoveryCodeExpiresAt DateTime?

  googleId String? @unique

  emails                  UserEmail[]
  sessions                Session[]
  twoFactorAuth           TwoFactorAuth?
  passkeys                Passkey[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  sellerProfile           SellerProfile?
  rider                   Rider?
  orders                  Order[]

  actionsReceived  AccountActionLog[] @relation("TargetUser")
  actionsPerformed AccountActionLog[] @relation("ActorUser")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  carts     Cart[]
  favorites Favorite[]
  productReviews ProductReview[]
  incidents Incident[]
  blogPosts BlogPost[]

  @@map("users")
}

model UserEmail {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  email      String  @unique
  isPrimary  Boolean @default(false)
  isVerified Boolean @default(false)

  verificationCode          String?
  verificationCodeExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("user_emails")
}

model AccountActionLog {
  id String @id @default(uuid())

  actorId   String?
  actor     User?   @relation("ActorUser", fields: [actorId], references: [id])
  actorRole String?

  targetUserId    String?
  targetUser      User?   @relation("TargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  targetUserEmail String

  action   String
  reason   String?
  metadata Json?

  createdAt DateTime @default(now())

  @@index([targetUserId])
  @@index([actorId])
  @@map("account_action_logs")
}

model Session {
  id               String @id @default(uuid())
  userId           String
  user             User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String @unique

  userAgent  String?
  ipAddress  String?
  deviceName String?

  isRevoked  Boolean  @default(false)
  expiresAt  DateTime
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

model TwoFactorAuth {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  secret String

  isEnabled Boolean @default(false)

  backupCodes TwoFactorBackupCode[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("two_factor_auth")
}

model TwoFactorBackupCode {
  id          String        @id @default(uuid())
  twoFactorId String
  twoFactor   TwoFactorAuth @relation(fields: [twoFactorId], references: [id], onDelete: Cascade)

  codeHash String

  isUsed Boolean   @default(false)
  usedAt DateTime?

  createdAt DateTime @default(now())

  @@index([twoFactorId])
  @@map("two_factor_backup_codes")
}

model Passkey {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  credentialId String @unique
  publicKey    String
  counter      BigInt @default(0)

  deviceType String?
  backedUp   Boolean @default(false)
  transports String?
  deviceName String?

  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("passkeys")
}

model Notification {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type  String
  title String
  body  String
  data  Json?

  isRead Boolean   @default(false)
  readAt DateTime?

  channels String[]

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, isRead])
  @@map("notifications")
}

model NotificationPreference {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type String

  inApp Boolean @default(true)
  email Boolean @default(true)
  sms   Boolean @default(false)
  push  Boolean @default(true)

  updatedAt DateTime @updatedAt

  @@unique([userId, type])
  @@map("notification_preferences")
}

model SellerProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  businessName        String
  businessDescription String
  logoUrl             String
  logoPublicId        String
  bannerUrl           String
  bannerPublicId      String

  contactPhone   String
  contactEmail   String
  whatsappNumber String

  address String
  city    String @default("Goma")

  status SellerProfileStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  kyc            SellerKyc?
  subscription   Subscription?
  invoices       Invoice[]
  walletSettings WalletSettings?
  shops          Shop[]
  riders         Rider[]
  wallet         Wallet?

  @@index([status])
  @@map("seller_profiles")
}

model SellerKyc {
  id              String        @id @default(uuid())
  sellerProfileId String        @unique
  sellerProfile   SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)

  idDocumentType     IdDocumentType
  idDocumentUrl      String
  idDocumentPublicId String

  proofOfAddressUrl      String
  proofOfAddressPublicId String

  rccmNumber           String?
  rccmDocumentUrl      String?
  rccmDocumentPublicId String?

  status KycStatus @default(PENDING)

  supportReviewedBy String?
  supportReviewedAt DateTime?

  adminReviewedBy String?
  adminReviewedAt DateTime?

  rejectedBy      String?
  rejectedAt      DateTime?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("seller_kyc")
}

model Plan {
  id   String @id @default(uuid())
  name String @unique
  slug String @unique

  maxProducts         Int
  maxPhotosPerProduct Int
  maxShops            Int     @default(1)
  prioritySupport     Boolean @default(false)

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  prices PlanPrice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]
  payments      SubscriptionPayment[]

  @@map("plans")
}

model PlanPrice {
  id     String @id @default(uuid())
  planId String
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  billingCycle BillingCycle
  currency     String
  amount       Decimal      @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([planId, billingCycle, currency])
  @@map("plan_prices")
}

model Subscription {
  id              String        @id @default(uuid())
  sellerProfileId String        @unique
  sellerProfile   SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)

  planId String
  plan   Plan   @relation(fields: [planId], references: [id])

  billingCycle BillingCycle
  currency     String

  status SubscriptionStatus @default(ACTIVE)

  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  autoRenew            Boolean   @default(true)
  renewalPhoneNumber   String?
  renewalProvider      String?
  renewalCountry       String?
  lastRenewalAttemptAt DateTime?

  canceledAt DateTime?

  payments SubscriptionPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([currentPeriodEnd])
  @@map("subscriptions")
}

model SubscriptionPayment {
  id             String       @id @default(uuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  planId String
  plan   Plan   @relation(fields: [planId], references: [id])

  billingCycle BillingCycle
  currency     String
  amount       Decimal      @db.Decimal(12, 2)

  provider            String  @default("PAWAPAY")
  mobileMoneyProvider String?
  payerPhoneNumber    String?
  country             String?
  depositId           String? @unique

  status        SubscriptionPaymentStatus @default(PENDING)
  failureReason String?
  paidAt        DateTime?

  periodStart DateTime
  periodEnd   DateTime

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  invoices  Invoice[]

  @@index([status])
  @@index([subscriptionId])
  @@map("subscription_payments")
}

model Invoice {
  id             String              @id @default(uuid())
  documentNumber String              @unique
  type           InvoiceDocumentType

  subscriptionPaymentId String?
  subscriptionPayment   SubscriptionPayment? @relation(fields: [subscriptionPaymentId], references: [id], onDelete: Cascade)

  orderPaymentId String?
  orderPayment   OrderPayment? @relation(fields: [orderPaymentId], references: [id], onDelete: Cascade)

  walletTransactionId String?
  walletTransaction   WalletTransaction? @relation(fields: [walletTransactionId], references: [id], onDelete: Cascade)

  sellerProfileId String
  sellerProfile   SellerProfile @relation(fields: [sellerProfileId], references: [id])

  pdfUrl      String
  pdfPublicId String

  issuedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subscriptionPaymentId, type])
  @@unique([orderPaymentId, type])
  @@unique([walletTransactionId, type])
  @@index([sellerProfileId])
  @@map("invoices")
}

model DocumentSequence {
  id    String @id
  value Int    @default(0)

  @@map("document_sequences")
}

model Shop {
  id              String        @id @default(uuid())
  sellerProfileId String
  sellerProfile   SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)

  name        String
  slug        String @unique
  description String

  logoUrl        String?
  logoPublicId   String?
  bannerUrl      String?
  bannerPublicId String?

  deliveryFee         Decimal @db.Decimal(12, 2)
  deliveryFeeCurrency String

  status      ShopStatus @default(DRAFT)
  publishedAt DateTime?

  suspendedBy      ShopSuspendedBy?
  suspensionReason String?

  deletedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
  orders    Order[]
  carts     Cart[]

  @@index([sellerProfileId])
  @@index([status])
  @@map("shops")
}

model Category {
  id   String @id @default(uuid())
  name String @unique
  slug String @unique

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  subcategories Subcategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categories")
}

model Subcategory {
  id         String   @id @default(uuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  name String
  slug String @unique

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@unique([categoryId, name])
  @@map("subcategories")
}

model Product {
  id            String      @id @default(uuid())
  shopId        String
  shop          Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  subcategoryId String
  subcategory   Subcategory @relation(fields: [subcategoryId], references: [id])

  name        String
  slug        String @unique
  description String

  brand       String?
  unit        String    @default("piece")
  weightGrams Int?
  expiresAt   DateTime?

  currency String

  status ProductStatus @default(DRAFT)

  hasVariants Boolean @default(false)

  images   ProductImage[]
  variants ProductVariant[]

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  orderItems OrderItem[]
  favorites  Favorite[]
  reviews    ProductReview[]

  @@index([shopId])
  @@index([subcategoryId])
  @@index([status])
  @@map("products")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@map("favorites")
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  url      String
  publicId String
  position Int    @default(0)

  createdAt DateTime @default(now())

  @@index([productId])
  @@map("product_images")
}

model ProductVariant {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  name       String?
  attributes Json?

  sku String? @unique

  price Decimal @db.Decimal(12, 2)
  stock Int     @default(0)

  isDefault Boolean @default(false)

  movements StockMovement[]

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  orderItems OrderItem[]
  cartItems  CartItem[]

  @@index([productId])
  @@map("product_variants")
}

model StockMovement {
  id        String         @id @default(uuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  type   StockMovementType
  amount Int
  reason String?

  stockBefore Int
  stockAfter  Int

  createdAt DateTime @default(now())

  @@index([variantId])
  @@map("stock_movements")
}

model Rider {
  id              String        @id @default(uuid())
  userId          String        @unique
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sellerProfileId String
  sellerProfile   SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)

  status        RiderStatus  @default(PENDING)
  vehicleType   VehicleType?
  photoUrl      String?
  photoPublicId String?
  isAvailable   Boolean      @default(false)

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]

  @@index([sellerProfileId])
  @@map("riders")
}

model Order {
  id      String  @id @default(uuid())
  buyerId String
  buyer   User    @relation(fields: [buyerId], references: [id])
  shopId  String
  shop    Shop    @relation(fields: [shopId], references: [id])
  riderId String?
  rider   Rider?  @relation(fields: [riderId], references: [id])

  paymentMethod     OrderPaymentMethod
  fulfillmentMethod OrderFulfillmentMethod
  status            OrderStatus            @default(PENDING_SELLER_REVIEW)

  currency    String
  subtotal    Decimal @db.Decimal(12, 2)
  deliveryFee Decimal @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)

  deliveryAddress   String?
  deliveryLatitude  Float?
  deliveryLongitude Float?

  qrToken     String    @unique
  qrScannedAt DateTime?

  cashCollected Decimal? @db.Decimal(12, 2)

  rejectionReason String?
  cancelReason    String?
  failureReason   String?

  acceptedAt  DateTime?
  pickedUpAt  DateTime?
  deliveredAt DateTime?
  completedAt DateTime?
  cancelledAt DateTime?
  rejectedAt  DateTime?

  items   OrderItem[]
  payment OrderPayment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([buyerId])
  @@index([shopId])
  @@index([riderId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id        String         @id @default(uuid())
  orderId   String
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product        @relation(fields: [productId], references: [id])
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  productName String
  variantName String?
  unitPrice   Decimal @db.Decimal(12, 2)
  quantity    Int
  subtotal    Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@map("order_items")
}

model OrderPayment {
  id      String @id @default(uuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  amount   Decimal @db.Decimal(12, 2)
  currency String

  provider    String  @default("MBIYOPAY")
  network     String?
  phoneNumber String?
  countryCode String?

  payinOrderId        String? @unique
  payinTransactionId  String? @unique
  payoutOrderId       String? @unique
  payoutTransactionId String? @unique

  status OrderPaymentStatus @default(PENDING)

  failureReason String?

  heldAt     DateTime?
  releasedAt DateTime?
  refundedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  invoices  Invoice[]

  @@map("order_payments")
}

model Cart {
  id      String @id @default(uuid())
  buyerId String
  buyer   User   @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  shopId  String
  shop    Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([buyerId, shopId])
  @@map("carts")
}

model CartItem {
  id        String         @id @default(uuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  quantity Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, variantId])
  @@map("cart_items")
}

model Wallet {
  id              String        @id @default(uuid())
  sellerProfileId String        @unique
  sellerProfile   SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)

  balances     WalletBalance[]
  transactions WalletTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("wallets")
}

model WalletBalance {
  id       String @id @default(uuid())
  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  currency           String
  balance            Decimal             @default(0) @db.Decimal(12, 2)
  walletTransactions WalletTransaction[]

  @@unique([walletId, currency])
  @@map("wallet_balances")
}

model WalletTransaction {
  id              String        @id @default(uuid())
  walletId        String
  wallet          Wallet        @relation(fields: [walletId], references: [id], onDelete: Cascade)
  walletBalanceId String
  walletBalance   WalletBalance @relation(fields: [walletBalanceId], references: [id], onDelete: Cascade)

  type   WalletTransactionType
  status WalletTransactionStatus @default(COMPLETED)

  amount   Decimal @db.Decimal(12, 2)
  currency String
  reason   String?

  balanceBefore Decimal @db.Decimal(12, 2)
  balanceAfter  Decimal @db.Decimal(12, 2)

  orderId             String?
  payoutOrderId       String?
  payoutTransactionId String?

  payoutFee           Decimal? @db.Decimal(12, 2)
  payoutChargedAmount Decimal? @db.Decimal(12, 2)

  attemptNumber Int                 @default(1)
  retryOfId     String?
  retryOf       WalletTransaction?  @relation("PayoutRetryChain", fields: [retryOfId], references: [id])
  retries       WalletTransaction[] @relation("PayoutRetryChain")

  createdAt DateTime  @default(now())
  invoices  Invoice[]

  @@unique([orderId, type])
  @@index([walletId])
  @@index([walletBalanceId])
  @@map("wallet_transactions")
}

model WalletSettings {
  id              String        @id @default(uuid())
  sellerProfileId String        @unique
  sellerProfile   SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)

  payoutPhoneNumber String
  payoutProvider    String
  payoutCountry     String

  minimumPayoutAmounts MinimumPayoutAmount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("wallet_settings")
}

model MinimumPayoutAmount {
  id               String         @id @default(uuid())
  walletSettingsId String
  walletSettings   WalletSettings @relation(fields: [walletSettingsId], references: [id], onDelete: Cascade)

  currency String
  amount   Decimal @db.Decimal(12, 2)

  @@unique([walletSettingsId, currency])
  @@map("minimum_payout_amounts")
}

model ExchangeRate {
  id           String  @id @default(uuid())
  fromCurrency String
  toCurrency   String
  rate         Decimal @db.Decimal(12, 6)

  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fromCurrency, toCurrency])
  @@map("exchange_rates")
}

model ProductReview {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  rating  Int
  comment String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, userId])
  @@index([productId])
  @@map("product_reviews")
}

enum IncidentSeverity {
  MINOR
  MAJOR
  CRITICAL
}

enum IncidentStatus {
  INVESTIGATING
  IDENTIFIED
  MONITORING
  RESOLVED
}

model Incident {
  id          String @id @default(uuid())
  title       String
  description String
  severity    IncidentSeverity @default(MINOR)
  status      IncidentStatus   @default(INVESTIGATING)

  createdBy String?
  creator   User?   @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  resolvedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("incidents")
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
}

model BlogPost {
  id            String @id @default(uuid())
  title         String
  slug          String @unique
  excerpt       String
  content       String
  coverImageUrl String?

  status      BlogPostStatus @default(DRAFT)
  publishedAt DateTime?

  authorId String?
  author   User?  @relation(fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([publishedAt])
  @@map("blog_posts")
}

model ContactMessage {
  id      String @id @default(uuid())
  name    String
  email   String
  subject String
  message String

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("contact_messages")
}
