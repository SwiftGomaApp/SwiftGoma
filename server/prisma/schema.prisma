generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  BUYER
  SELLER
  DELIVERER
  SUPPORT
  ADMIN
}

enum OtpType {
  EMAIL_VERIFICATION
  PHONE_VERIFICATION
  ACCOUNT_VERIFICATION
  SIGNIN
  RESET_PASSWORD
  CHANGE_EMAIL
  CHANGE_PHONE
  TWO_FACTOR
  REMOVE_PASSKEY
  DISCONNECT_GOOGLE
  DISABLE_2FA
  REGENERATE_BACKUP_CODES
}

enum ComponentStatus {
  OPERATIONAL
  DEGRADED
  PARTIAL_OUTAGE
  MAJOR_OUTAGE
}

enum IncidentStatus {
  INVESTIGATING
  IDENTIFIED
  MONITORING
  RESOLVED
}

enum IncidentSeverity {
  MINOR
  MAJOR
  CRITICAL
}

enum KycStatus {
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
}

enum Language {
  FR
  SW
}

enum Currency {
  CDF
  USD
}

enum VehicleType {
  MOTO
  VELO
  PIED
  VOITURE
}

enum PushPlatform {
  WEB
  ANDROID
  IOS
}

enum NotificationType {
  SYSTEM
  ORDER
  PAYMENT
  DELIVERY
  KYC
  ACCOUNT
  PROMOTION
}

enum ShopCategory {
  ALIMENTATION
  RESTAURATION
  VETEMENTS
  ELECTRONIQUE
  BEAUTE
  MAISON
  AGRICULTURE
  PHARMACIE
  SERVICES
  AUTRE
}

enum ShopStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  CLOSED
}

enum PlanTier {
  STARTER
  BUSINESS
  ENTERPRISE
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING_PAYMENT
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum InvoiceType {
  SUBSCRIPTION
  ORDER
  WALLET_TOPUP
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  OUT_OF_STOCK
  ARCHIVED
}

enum CategoryStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MobileMoneyProvider {
  ORANGE
  AIRTEL
  MPESA
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  MOBILE_MONEY
  CASH_ON_DELIVERY
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id                String    @id @default(uuid())
  name              String
  phone             String?   @unique
  email             String?   @unique
  password          String?
  passwordChangedAt DateTime?
  role              Role      @default(BUYER)
  avatar            String?
  googleId          String?   @unique

  secondaryEmail           String?   @unique
  isSecondaryEmailVerified Boolean   @default(false)
  secondaryEmailAddedAt    DateTime?

  isVerified      Boolean @default(false)
  isDeleted       Boolean @default(false)
  isEmailVerified Boolean @default(false)
  isPhoneVerified Boolean @default(false)
  isActive        Boolean @default(true)
  isBlocked       Boolean @default(false)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  otps                Otp[]
  refreshTokens       RefreshToken[]
  sessions            Session[]
  passkeys            Passkey[]
  totp                Totp?
  backupCodes         BackupCode[]
  addresses           Address[]
  preferences         UserPreferences?
  sellerProfile       SellerProfile?
  delivererProfile    DelivererProfile?
  pushTokens          PushToken[]
  notifications       Notification[]
  subscription        SellerSubscription?
  invoices            Invoice[]
  categorySuggestions Category[]          @relation("CategorySuggester")
  kycReviews          KycRequest[]        @relation("KycReviewer")
  orders              Order[]             @relation("BuyerOrders")

  @@map("users")
}

model Otp {
  id        String    @id @default(uuid())
  userId    String
  code      String
  type      String
  target    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("otps")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  sessionId String?
  token     String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@map("refresh_tokens")
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  device       String?
  browser      String?
  os           String?
  ip           String?
  location     String?
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Passkey {
  id           String    @id @default(uuid())
  userId       String
  name         String
  credentialId String    @unique
  publicKey    Bytes
  counter      BigInt    @default(0)
  deviceType   String?
  backedUp     Boolean   @default(false)
  transports   String[]
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passkeys")
}

model Totp {
  id        String    @id @default(uuid())
  userId    String    @unique
  secret    String
  isEnabled Boolean   @default(false)
  enabledAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("totp")
}

model BackupCode {
  id        String    @id @default(uuid())
  userId    String
  code      String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("backup_codes")
}

model Address {
  id        String   @id @default(uuid())
  userId    String
  label     String
  commune   String
  quartier  String
  avenue    String
  reference String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

model UserPreferences {
  id       String   @id @default(uuid())
  userId   String   @unique
  language Language @default(FR)
  timezone String   @default("Africa/Lubumbashi")
  currency Currency @default(CDF)
  darkMode Boolean  @default(false)

  notifyInApp Boolean @default(true)
  notifyEmail Boolean @default(true)
  notifyPush  Boolean @default(true)
  notifySms   Boolean @default(false)

  notificationSettings Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model PushToken {
  id        String       @id @default(uuid())
  userId    String
  token     String       @unique
  platform  PushPlatform
  deviceId  String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

model SellerProfile {
  id          String    @id @default(uuid())
  userId      String    @unique
  shopName    String
  description String?
  logo        String?
  commune     String
  quartier    String
  avenue      String?
  isApproved  Boolean   @default(false)
  approvedAt  DateTime?
  approvedBy  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  delivererProfiles DelivererProfile[]
  shops             Shop[]
  kycRequest        KycRequest?

  @@map("seller_profiles")
}

model KycRequest {
  id              String    @id @default(uuid())
  sellerProfileId String    @unique
  documents       String[]
  status          KycStatus @default(PENDING)
  note            String?
  reviewedBy      String?
  reviewedAt      DateTime?
  submittedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sellerProfile SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)
  reviewer      User?         @relation("KycReviewer", fields: [reviewedBy], references: [id])

  @@index([status])
  @@map("kyc_requests")
}

model Shop {
  id              String @id @default(uuid())
  sellerProfileId String

  name     String
  slug     String       @unique
  category ShopCategory
  status   ShopStatus   @default(ACTIVE)

  email          String?
  phone          String?
  whatsappNumber String?

  logo        String?
  banner      String?
  description String?
  tags        String[]

  commune   String
  quartier  String
  avenue    String?
  reference String?
  latitude  Float
  longitude Float

  workingHours        Json?
  isTemporarilyClosed Boolean   @default(false)
  closedUntil         DateTime?

  currency           Currency @default(CDF)
  minimumOrderAmount Int?
  deliveryAvailable  Boolean  @default(false)

  socialLinks Json?

  isVerified       Boolean   @default(false)
  verifiedAt       DateTime?
  suspendedAt      DateTime?
  suspensionReason String?

  totalOrders   Int   @default(0)
  totalReviews  Int   @default(0)
  averageRating Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sellerProfile SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)
  products      Product[]
  orders        Order[]

  @@index([sellerProfileId])
  @@index([slug])
  @@index([status])
  @@index([category])
  @@map("shops")
}

model DelivererProfile {
  id              String      @id @default(uuid())
  userId          String      @unique
  sellerProfileId String
  zone            String
  vehicleType     VehicleType @default(MOTO)
  isAvailable     Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sellerProfile SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)
  orders        Order[]

  @@map("deliverer_profiles")
}

// ─── Seller plans & subscriptions ─────────────────────────────────────────────

model SellerPlan {
  id          String   @id @default(uuid())
  tier        PlanTier @unique
  name        String
  description String?
  isActive    Boolean  @default(true)

  priceCdfMonthly Int
  priceCdfAnnual  Int
  priceUsdMonthly Int
  priceUsdAnnual  Int

  maxShops            Int
  maxProducts         Int
  maxImagesPerProduct Int
  maxVariants         Int
  maxFeaturedProducts Int
  maxDeliverers       Int @default(1)

  canFeatureProducts     Boolean @default(false)
  analyticsRetentionDays Int
  hasPrioritySupport     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions SellerSubscription[]

  @@map("seller_plans")
}

model SellerSubscription {
  id           String             @id @default(uuid())
  userId       String             @unique
  planId       String
  status       SubscriptionStatus @default(PENDING_PAYMENT)
  billingCycle BillingCycle
  currency     Currency
  amount       Int
  startedAt    DateTime?
  expiresAt    DateTime?
  cancelledAt  DateTime?
  autoRenew    Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan     SellerPlan            @relation(fields: [planId], references: [id])
  payments SubscriptionPayment[]

  @@map("seller_subscriptions")
}

model SubscriptionPayment {
  id               String              @id @default(uuid())
  subscriptionId   String
  amount           Int
  currency         Currency
  provider         MobileMoneyProvider
  pawapayDepositId String              @unique
  phoneNumber      String
  status           PaymentStatus       @default(PENDING)
  paidAt           DateTime?
  failedAt         DateTime?
  failureReason    String?
  metadata         Json?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  subscription SellerSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([pawapayDepositId])
  @@map("subscription_payments")
}

// ─── Invoices ─────────────────────────────────────────────────────────────────

model InvoiceCounter {
  id       String @id @default(uuid())
  year     Int    @unique
  sequence Int    @default(0)

  @@map("invoice_counters")
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique
  userId        String
  type          InvoiceType
  status        InvoiceStatus @default(DRAFT)
  amount        Int
  currency      Currency
  items         Json
  pdfUrl        String?
  referenceId   String?
  referenceType String?
  issuedAt      DateTime?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([invoiceNumber])
  @@map("invoices")
}

// ─── Products ─────────────────────────────────────────────────────────────────

model Category {
  id           String         @id @default(uuid())
  name         String
  slug         String         @unique
  description  String?
  image        String?
  parentId     String?
  status       CategoryStatus @default(PENDING)
  suggestedBy  String?
  rejectedNote String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  parent    Category?  @relation("CategoryChildren", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryChildren")
  products  Product[]
  suggester User?      @relation("CategorySuggester", fields: [suggestedBy], references: [id])

  @@index([parentId])
  @@index([status])
  @@map("categories")
}

model Product {
  id          String        @id @default(uuid())
  shopId      String
  categoryId  String?
  name        String
  slug        String        @unique
  description String?
  price       Int
  priceUsd    Float?
  stock       Int           @default(0)
  status      ProductStatus @default(DRAFT)
  isFeatured  Boolean       @default(false)
  featuredAt  DateTime?
  tags        String[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  shop       Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  category   Category?        @relation(fields: [categoryId], references: [id])
  images     ProductImage[]
  variants   ProductVariant[]
  orderItems OrderItem[]

  @@index([shopId])
  @@index([categoryId])
  @@index([status])
  @@index([isFeatured])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  url       String
  isPrimary Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductVariant {
  id        String   @id @default(uuid())
  productId String
  name      String
  options   Json
  price     Int?
  priceUsd  Float?
  stock     Int      @default(0)
  sku       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_variants")
}

// ─── Status page ──────────────────────────────────────────────────────────────

model Component {
  id            String          @id @default(uuid())
  slug          String          @unique
  name          String
  currentStatus ComponentStatus @default(OPERATIONAL)
  lastCheckedAt DateTime?
  createdAt     DateTime        @default(now())

  healthChecks HealthCheck[]

  @@map("status_components")
}

model HealthCheck {
  id             String          @id @default(uuid())
  componentId    String
  status         ComponentStatus
  responseTimeMs Int?
  message        String?
  checkedAt      DateTime        @default(now())

  component Component @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@index([componentId, checkedAt])
  @@map("status_health_checks")
}

model Incident {
  id                     String           @id @default(uuid())
  title                  String
  severity               IncidentSeverity
  status                 IncidentStatus   @default(INVESTIGATING)
  affectedComponentSlugs String[]
  createdAt              DateTime         @default(now())
  resolvedAt             DateTime?

  updates IncidentUpdate[]

  @@map("status_incidents")
}

model IncidentUpdate {
  id         String         @id @default(uuid())
  incidentId String
  status     IncidentStatus
  message    String
  createdAt  DateTime       @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@map("status_incident_updates")
}

// ─── Orders ───────────────────────────────────────────────────────────────────
model OrderCounter {
  id       String @id @default(uuid())
  year     Int    @unique
  sequence Int    @default(0)

  @@map("order_counters")
}

model Order {
  id            String        @id @default(uuid())
  orderNumber   String        @unique
  buyerId       String
  shopId        String
  delivererId   String?
  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod
  note          String?

  commune   String
  quartier  String
  avenue    String?
  reference String?

  subtotal    Int
  deliveryFee Int      @default(0)
  total       Int
  currency    Currency

  confirmedAt  DateTime?
  preparingAt  DateTime?
  shippedAt    DateTime?
  deliveredAt  DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  cancelledBy  String?
  cancelReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lastLatitude   Float?
  lastLongitude  Float?
  lastLocationAt DateTime?

  buyer     User              @relation("BuyerOrders", fields: [buyerId], references: [id])
  shop      Shop              @relation(fields: [shopId], references: [id])
  deliverer DelivererProfile? @relation(fields: [delivererId], references: [id])
  items     OrderItem[]
  payment   OrderPayment?

  @@index([buyerId])
  @@index([shopId])
  @@index([delivererId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  variantId String?

  name        String
  price       Int
  priceUsd    Float?
  variantName String?
  options     Json?

  quantity Int
  total    Int

  createdAt DateTime @default(now())

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model OrderPayment {
  id               String              @id @default(uuid())
  orderId          String              @unique
  pawapayDepositId String              @unique
  phoneNumber      String
  provider         MobileMoneyProvider
  amount           Int
  currency         Currency
  status           PaymentStatus       @default(PENDING)
  paidAt           DateTime?
  failedAt         DateTime?
  failureReason    String?
  metadata         Json?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([pawapayDepositId])
  @@map("order_payments")
}
