generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  BUYER
  SELLER
  DELIVERER
  SUPPORT
  ADMIN
}

enum OtpType {
  EMAIL_VERIFICATION
  PHONE_VERIFICATION
  ACCOUNT_VERIFICATION
  SIGNIN
  RESET_PASSWORD
  CHANGE_EMAIL
  CHANGE_PHONE
  TWO_FACTOR
  REMOVE_PASSKEY
  DISCONNECT_GOOGLE
  DISABLE_2FA
  REGENERATE_BACKUP_CODES
}

enum ComponentStatus {
  OPERATIONAL
  DEGRADED
  PARTIAL_OUTAGE
  MAJOR_OUTAGE
}

enum IncidentStatus {
  INVESTIGATING
  IDENTIFIED
  MONITORING
  RESOLVED
}

enum IncidentSeverity {
  MINOR
  MAJOR
  CRITICAL
}

enum Language {
  FR
  SW
}

enum KycStatus {
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id                String    @id @default(uuid())
  name              String
  phone             String?   @unique
  email             String?   @unique
  password          String?
  passwordChangedAt DateTime?
  role              Role      @default(BUYER)
  avatar            String?
  googleId          String?   @unique

  secondaryEmail           String?   @unique
  isSecondaryEmailVerified Boolean   @default(false)
  secondaryEmailAddedAt    DateTime?

  isVerified      Boolean @default(false)
  isDeleted       Boolean @default(false)
  isEmailVerified Boolean @default(false)
  isPhoneVerified Boolean @default(false)
  isActive        Boolean @default(true)
  isBlocked       Boolean @default(false)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  otps          Otp[]
  refreshTokens RefreshToken[]
  sessions      Session[]
  passkeys      Passkey[]
  totp          Totp?
  backupCodes   BackupCode[]
  addresses     Address[]
  sellerProfile SellerProfile?
  kycReviews    Kyc[]          @relation("KycReviewer")

  @@map("users")
}

model Otp {
  id        String    @id @default(uuid())
  userId    String
  code      String
  type      String
  target    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("otps")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  sessionId String?
  token     String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@map("refresh_tokens")
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  device       String?
  browser      String?
  os           String?
  ip           String?
  location     String?
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Passkey {
  id           String    @id @default(uuid())
  userId       String
  name         String
  credentialId String    @unique
  publicKey    Bytes
  counter      BigInt    @default(0)
  deviceType   String?
  backedUp     Boolean   @default(false)
  transports   String[]
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passkeys")
}

model Totp {
  id        String    @id @default(uuid())
  userId    String    @unique
  secret    String
  isEnabled Boolean   @default(false)
  enabledAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("totp")
}

model BackupCode {
  id        String    @id @default(uuid())
  userId    String
  code      String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("backup_codes")
}

model Address {
  id        String   @id @default(uuid())
  userId    String
  label     String
  commune   String
  quartier  String
  avenue    String
  reference String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

// ─── PROFILES ───────────────────────────────────────────────────────────────────

model SellerProfile {
  id          String    @id @default(uuid())
  userId      String    @unique
  shopName    String
  description String?
  logo        String
  commune     String
  quartier    String
  avenue      String
  isApprouved Boolean   @default(true)
  approuvedAt DateTime?
  approuvedBy String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  kyc  Kyc?

  @@map("seller_profiles")
}

model Kyc {
  id              String    @id @default(uuid())
  sellerProfileId String    @unique
  documents       String[]
  status          KycStatus @default(PENDING)
  note            String?
  reviewedBy      String?
  reviewedAt      DateTime?
  submittedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sellerProfile SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)
  reviewer      User?         @relation("KycReviewer", fields: [reviewedBy], references: [id])

  @@index([status])
  @@map("kyc")
}
