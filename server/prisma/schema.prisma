generator client {
  provider               = "prisma-client-js"
  output                 = "../generated/prisma"
  moduleFormat           = "cjs"
  generatedFileExtension = "js"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  BUYER
  SELLER
  RIDER
  ADMIN
  SUPPORT
}

model User {
  id           String  @id @default(uuid())
  name         String
  phone        String?
  pendingPhone String?
  password     String?
  role         Role    @default(BUYER)
  avatarUrl    String?

  isPhoneVerified Boolean @default(false)
  isBlocked       Boolean @default(false)

  deletedAt      DateTime?
  deletionReason String?

  phoneVerificationCode          String?
  phoneVerificationCodeExpiresAt DateTime?

  loginOtp          String?
  loginOtpExpiresAt DateTime?

  passwordResetCode          String?
  passwordResetCodeExpiresAt DateTime?

  accountRecoveryCode          String?
  accountRecoveryCodeExpiresAt DateTime?

  googleId String? @unique

  emails        UserEmail[]
  sessions      Session[]
  twoFactorAuth TwoFactorAuth?
  passkeys      Passkey[]

  actionsReceived  AccountActionLog[] @relation("TargetUser")
  actionsPerformed AccountActionLog[] @relation("ActorUser")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model UserEmail {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  email      String  @unique
  isPrimary  Boolean @default(false)
  isVerified Boolean @default(false)

  verificationCode          String?
  verificationCodeExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("user_emails")
}

model AccountActionLog {
  id String @id @default(uuid())

  actorId   String?
  actor     User?   @relation("ActorUser", fields: [actorId], references: [id])
  actorRole String?

  targetUserId    String?
  targetUser      User?   @relation("TargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  targetUserEmail String

  action   String
  reason   String?
  metadata Json?

  createdAt DateTime @default(now())

  @@index([targetUserId])
  @@index([actorId])
  @@map("account_action_logs")
}

model Session {
  id               String @id @default(uuid())
  userId           String
  user             User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String @unique

  userAgent  String?
  ipAddress  String?
  deviceName String?

  isRevoked  Boolean  @default(false)
  expiresAt  DateTime
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

model TwoFactorAuth {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  secret String

  isEnabled Boolean @default(false)

  backupCodes TwoFactorBackupCode[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("two_factor_auth")
}

model TwoFactorBackupCode {
  id          String        @id @default(uuid())
  twoFactorId String
  twoFactor   TwoFactorAuth @relation(fields: [twoFactorId], references: [id], onDelete: Cascade)

  codeHash String

  isUsed Boolean   @default(false)
  usedAt DateTime?

  createdAt DateTime @default(now())

  @@index([twoFactorId])
  @@map("two_factor_backup_codes")
}

model Passkey {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  credentialId String @unique
  publicKey    String
  counter      BigInt @default(0)

  deviceType String?
  backedUp   Boolean @default(false)
  transports String?
  deviceName String?

  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("passkeys")
}
