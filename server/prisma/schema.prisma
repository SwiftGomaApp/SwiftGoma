generator client {
  provider               = "prisma-client-js"
  output                 = "../generated/prisma"
  moduleFormat           = "cjs"
  generatedFileExtension = "js"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  BUYER
  SELLER
  RIDER
  ADMIN
  SUPPORT
}

enum SellerProfileStatus {
  DRAFT
  ACTIVE
  SUSPENDED
}

enum KycStatus {
  PENDING
  SUPPORT_REVIEWED
  APPROVED
  REJECTED
}

enum IdDocumentType {
  NATIONAL_ID
  VOTER_CARD
  PASSPORT
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

model User {
  id           String  @id @default(uuid())
  name         String
  phone        String?
  pendingPhone String?
  password     String?
  role         Role    @default(BUYER)
  avatarUrl    String?

  isPhoneVerified Boolean @default(false)
  isBlocked       Boolean @default(false)

  deletedAt      DateTime?
  deletionReason String?

  phoneVerificationCode          String?
  phoneVerificationCodeExpiresAt DateTime?

  loginOtp          String?
  loginOtpExpiresAt DateTime?

  passwordResetCode          String?
  passwordResetCodeExpiresAt DateTime?

  accountRecoveryCode          String?
  accountRecoveryCodeExpiresAt DateTime?

  googleId String? @unique

  emails                  UserEmail[]
  sessions                Session[]
  twoFactorAuth           TwoFactorAuth?
  passkeys                Passkey[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  sellerProfile           SellerProfile?

  actionsReceived  AccountActionLog[] @relation("TargetUser")
  actionsPerformed AccountActionLog[] @relation("ActorUser")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model UserEmail {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  email      String  @unique
  isPrimary  Boolean @default(false)
  isVerified Boolean @default(false)

  verificationCode          String?
  verificationCodeExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("user_emails")
}

model AccountActionLog {
  id String @id @default(uuid())

  actorId   String?
  actor     User?   @relation("ActorUser", fields: [actorId], references: [id])
  actorRole String?

  targetUserId    String?
  targetUser      User?   @relation("TargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  targetUserEmail String

  action   String
  reason   String?
  metadata Json?

  createdAt DateTime @default(now())

  @@index([targetUserId])
  @@index([actorId])
  @@map("account_action_logs")
}

model Session {
  id               String @id @default(uuid())
  userId           String
  user             User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String @unique

  userAgent  String?
  ipAddress  String?
  deviceName String?

  isRevoked  Boolean  @default(false)
  expiresAt  DateTime
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

model TwoFactorAuth {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  secret String

  isEnabled Boolean @default(false)

  backupCodes TwoFactorBackupCode[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("two_factor_auth")
}

model TwoFactorBackupCode {
  id          String        @id @default(uuid())
  twoFactorId String
  twoFactor   TwoFactorAuth @relation(fields: [twoFactorId], references: [id], onDelete: Cascade)

  codeHash String

  isUsed Boolean   @default(false)
  usedAt DateTime?

  createdAt DateTime @default(now())

  @@index([twoFactorId])
  @@map("two_factor_backup_codes")
}

model Passkey {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  credentialId String @unique
  publicKey    String
  counter      BigInt @default(0)

  deviceType String?
  backedUp   Boolean @default(false)
  transports String?
  deviceName String?

  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("passkeys")
}

model Notification {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type  String
  title String
  body  String
  data  Json?

  isRead Boolean   @default(false)
  readAt DateTime?

  channels String[]

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, isRead])
  @@map("notifications")
}

model NotificationPreference {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type String

  inApp Boolean @default(true)
  email Boolean @default(true)
  sms   Boolean @default(false)
  push  Boolean @default(true)

  updatedAt DateTime @updatedAt

  @@unique([userId, type])
  @@map("notification_preferences")
}

model SellerProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  businessName        String
  businessDescription String
  logoUrl             String
  logoPublicId        String
  bannerUrl           String
  bannerPublicId      String

  contactPhone   String
  contactEmail   String
  whatsappNumber String

  address String
  city    String @default("Goma")

  status SellerProfileStatus @default(DRAFT)

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  kyc       SellerKyc?

  @@index([status])
  @@map("seller_profiles")
}

model SellerKyc {
  id              String        @id @default(uuid())
  sellerProfileId String        @unique
  sellerProfile   SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)

  idDocumentType     IdDocumentType
  idDocumentUrl      String
  idDocumentPublicId String

  proofOfAddressUrl      String
  proofOfAddressPublicId String

  rccmNumber           String?
  rccmDocumentUrl      String?
  rccmDocumentPublicId String?

  status KycStatus @default(PENDING)

  supportReviewedBy String?
  supportReviewedAt DateTime?

  adminReviewedBy String?
  adminReviewedAt DateTime?

  rejectedBy      String?
  rejectedAt      DateTime?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("seller_kyc")
}

model Plan {
  id   String @id @default(uuid())
  name String @unique
  slug String @unique

  maxProducts         Int
  maxPhotosPerProduct Int
  prioritySupport     Boolean @default(false)

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  prices PlanPrice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("plans")
}

model PlanPrice {
  id     String @id @default(uuid())
  planId String
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  billingCycle BillingCycle
  currency     String
  amount       Decimal      @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([planId, billingCycle, currency])
  @@map("plan_prices")
}
