# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
COOKIE_SECRET=

# ─── Sentry ───────────────────────────────────────────────────────────────────
SENTRY_DSN=

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/swiftgoma

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.hostinger.com
SMTP_USER=
SMTP_PASS=
EMAIL_PORT=587
EMAIL_FROM=SwiftGoma <noreply@swiftgoma.com>

# ─── OTP ──────────────────────────────────────────────────────────────────────
OTP_EXPIRES_IN_MINUTES=10

# ─── SMS — Africa's Talking ───────────────────────────────────────────────────
AT_API_KEY=
AT_USERNAME=
AT_SENDER_ID=SwiftGoma

# ─── Passkeys (WebAuthn) ──────────────────────────────────────────────────────
RP_NAME=SwiftGoma
RP_ID=swiftgoma.com
CLIENT_URL=http://localhost:3000
CHALLENGE_TTL=300000

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Cloudinary ───────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── PawaPay ──────────────────────────────────────────────────────────────────
PAWAPAY_API_TOKEN=
PAWAPAY_SANDBOX=true



SUPPORT_EMAIL=
SUPPORT_PASSWORD=